{
  "agent-memory-nams": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "\"$(git rev-parse --show-toplevel)/bin/agent-memory-hook\" --backend nams --event SessionStart",
        "timeout": 120
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "\"$(git rev-parse --show-toplevel)/bin/agent-memory-hook\" --backend nams --event PreInvocation",
        "timeout": 120
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/bin/agent-memory-hook\" --backend nams --event PostToolUse",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "\"$(git rev-parse --show-toplevel)/bin/agent-memory-hook\" --backend nams --event Stop",
        "timeout": 120
      }
    ]
  }
}
