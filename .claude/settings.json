{
  "extraKnownMarketplaces": {
    "nams-plugins": {
      "source": {
        "source": "github",
        "repo": "neo4j-labs/nams-plugins",
        "ref": "latest"
      }
    }
  },
  "enabledPlugins": {
    "nams-hooks@nams-plugins": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/agent-memory-hook",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/agent-memory-hook",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/agent-memory-hook",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/agent-memory-hook",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
