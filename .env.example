# Copy to .env and fill in. .env is git-ignored.

# 1) Neo4j Labs Agent Memory (neo4j-agent-memory) on your Neo4j Aura instance (Aura console -> instance -> Connect)
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here

# 2) Neo4j Agent Memory Service (NAMS): workspace key from https://memory.neo4jlabs.com -> API Keys
NAMS_API_KEY=
NAMS_BASE_URL=https://memory.neo4jlabs.com

# LLM for the SDK's extraction (via LiteLLM), the Haystack agents and the judge:
# Azure OpenAI if the endpoint is set, otherwise OpenAI
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=your_key_here
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
# OPENAI_API_KEY=sk-...

# Optional overrides for bin/agent-memory-mcp
# AGENT_MEMORY_EMBEDDING=BAAI/bge-small-en-v1.5
# AGENT_MEMORY_PROFILE=extended
# NAM_SCHEMA_CONFIG__ONTOLOGY_PATH=ontology/agent-memory-software-team.json
